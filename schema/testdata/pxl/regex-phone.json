      ]
    },
    {
      "name": "phone unknown region at run time",
      "expr": "isPhone(phone, name)",
      "value": false,
      "type": "bool",
      "program": "AQACBGJvb2wCBAVwaG9uZQQEbmFtZQIEbmFtZQVwaG9uZQoGAAAGAQBJlgAC",
      "asm": [
        "0000 LOAD_ROOT 0 ; \"phone\"",
        "0003 LOAD_ROOT 1 ; \"name\"",
        "0006 CALL 150 2 ; isPhone"
      ],
      "reads": [
