{
  "description": "Checks with the server whether a name is free; a delay stands in for the request.",
  "id": "01f0c450-6c00-7000-8000-000000000705",
  "key": "check-name",
  "kind": "actionGraph",
  "output": "string?",
  "schemaVersion": "1.0.0",
  "steps": [
    {
      "action": "delay",
      "id": "ask",
      "input": {
        "duration": 100
      },
      "next": "check"
    },
    {
      "action": "condition",
      "branches": {
        "then": "taken"
      },
      "id": "check",
      "input": {
        "when": {
          "$expr": "event == \"taken\""
        }
      }
    },
    {
      "action": "stop",
      "id": "taken",
      "input": {
        "result": "That name is taken"
      }
    }
  ]
}
