          "child": {
            "children": [
              {
                "id": "01e0c450-6c00-7000-8000-00000000006f",
                "props": {
                  "data": {
                    "$expr": "\"Place: \" + params.name"
                  }
                },
                "type": "Text"
              },
              {
                "events": {
                  "onPressed": {
                    "steps": [
