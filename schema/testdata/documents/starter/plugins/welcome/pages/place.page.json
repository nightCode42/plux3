                        "next": "tell"
                      },
                      {
                        "action": "emitHostEvent",
                        "id": "tell",
                        "input": {
                          "event": "placeShared",
                          "payload": {
                            "name": {
                              "$expr": "params.name"
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                "id": "01e0c450-6c00-7000-8000-000000000091",
                "slots": {
                  "child": {
                    "id": "01e0c450-6c00-7000-8000-000000000092",
                    "props": {
                      "data": "Share"
                    },
                    "type": "Text"
                  }
                },
                "type": "TextButton"
              },
              {
                "events": {
                  "onPressed": {
                    "steps": [
                      {
                        "action": "navigate",
                        "id": "go",
                        "input": {
                          "params": {
                            "name": {
                              "$expr": "params.name"
                            }
                          },
                          "route": "profile"
