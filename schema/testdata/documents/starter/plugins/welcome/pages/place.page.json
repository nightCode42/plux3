                      }
                    ]
                  }
                },
                "id": "01e0c450-6c00-7000-8000-000000000093",
                "slots": {
                  "child": {
                    "id": "01e0c450-6c00-7000-8000-000000000094",
                    "props": {
                      "data": "Profile"
                    },
                    "type": "Text"
                  }
                },
                "testId": "place-profile",
                "type": "TextButton"
              }
            ],
            "id": "01e0c450-6c00-7000-8000-000000000090",
            "props": {
              "mainAxisSize": "min"
            },
            "type": "Column"
          }
        },
        "type": "Center"
      }
    },
    "type": "Scaffold"
  },
  "route": "place",
  "schemaVersion": "1.0.0",
  "title": "Place"
