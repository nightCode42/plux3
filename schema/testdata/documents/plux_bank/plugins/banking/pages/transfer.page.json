                          {
                            "action": "apiCall",
                            "id": "send",
                            "input": {
                              "input": {
                                "amountCents": {
                                  "$expr": "int(mul(decimal(steps.submit.output.amount), 100d))"
                                },
                                "fromAccountId": "acct-001",
                                "reference": {
                                  "$expr": "steps.submit.output.reference"
                                },
                                "toIban": {
                                  "$expr": "steps.submit.output.toIban"
                                }
                              },
                              "operation": "api.transfer"
                            },
                            "onError": "failed",
                            "onSuccess": "done"
                          },
                          {
                            "action": "navigate",
                            "id": "done",
                            "input": {
                              "mode": "replace",
                              "params": {
                                "amountCents": {
                                  "$expr": "int(mul(decimal(steps.submit.output?.amount ?? \"0\"), 100d))"
                                },
                                "balanceCents": {
                                  "$expr": "steps.send.output?.balanceCents ?? 0"
                                },
                                "message": "",
                                "ok": true
                              },
                              "route": "result"
                            }
                          },
                          {
                            "action": "showSnackbar",
                            "id": "invalid",
                            "input": {
