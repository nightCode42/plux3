{
  "forms": [
    {
      "fields": [
        {
          "initial": 0,
          "name": "balanceCents",
          "type": "int"
        },
        {
          "initial": "",
          "name": "toIban",
          "type": "string",
          "validators": [
            {
              "kind": "required",
              "message": "Enter the recipient's IBAN"
            },
            {
              "kind": "regex",
              "message": "Enter a valid IBAN",
              "pattern": "^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$"
            }
          ]
        },
        {
          "initial": "",
          "name": "amount",
          "type": "string",
          "validators": [
            {
              "kind": "required",
              "message": "Enter an amount"
            },
            {
              "kind": "decimalPrecision",
              "maxIntegerDigits": 9,
              "maxScale": 2,
              "message": "Use at most two decimals"
            },
            {
              "kind": "custom",
              "message": "The amount must be above zero and within your balance",
              "rule": {
                "$expr": "matches(value, \"^[0-9]{1,9}([.][0-9]{1,2})?$\") && int(mul(decimal(value), 100d)) > 0 && int(mul(decimal(value), 100d)) <= form.balanceCents"
              }
            }
          ]
        },
        {
          "initial": "",
          "name": "reference",
          "type": "string",
          "validators": [
            {
              "kind": "length",
              "max": 40,
              "message": "Use at most 40 characters"
            }
          ]
        }
      ],
      "id": "01d0c450-6c00-7000-8000-000000000231",
      "name": "transfer"
    }
