{
  "description": "Stores the schedule and opens the result page.",
  "id": "01a0c450-6c00-7021-8000-00000003fccf",
  "key": "calculate",
  "kind": "actionGraph",
  "page": "01a0c450-6c00-7012-8000-000000022cce",
  "schemaVersion": "1.0.0",
  "steps": [
    {
      "action": "setState",
      "id": "store",
      "input": {
        "path": "plugin.lastSchedule",
        "value": {
          "$expr": "{\"monthlyPayment\": page.monthlyPayment, \"totalInterest\": page.monthlyPayment * decimal(page.months) - page.amount, \"months\": page.months}"
        }
      },
      "next": "track"
    },
    {
      "action": "trackEvent",
      "id": "track",
      "input": {
        "name": "loan_calculated",
        "props": {
          "months": {
            "$expr": "page.months"
          }
        }
      },
      "next": "open"
    },
    {
      "action": "navigate",
      "id": "open",
      "input": {
        "params": {
          "schedule": {
            "$expr": "plugin.lastSchedule"
          }
        },
        "route": "result"
      }
    }
  ]
}
