{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/update/root.schema.json",
  "title": "Update root metadata",
  "description": "The root of trust: the keys and the signing threshold of every role (SEC-122).",
  "type": "object",
  "required": [
    "signed",
    "signatures"
  ],
  "properties": {
    "signed": {
      "type": "object",
      "required": [
        "_type",
        "version",
        "expires",
        "specVersion",
        "keys",
        "roles"
      ],
      "properties": {
        "_type": {
          "const": "root"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "expires": {
          "$ref": "common.schema.json#/$defs/signedBase/properties/expires"
        },
        "specVersion": {
          "$ref": "common.schema.json#/$defs/signedBase/properties/specVersion"
        },
        "keys": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/keyId"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "alg",
              "public"
            ],
            "properties": {
              "alg": {
                "$ref": "common.schema.json#/$defs/alg"
              },
              "public": {
                "$ref": "common.schema.json#/$defs/base64"
              }
            },
            "additionalProperties": false
          }
        },
        "roles": {
          "type": "object",
          "required": [
            "root",
            "targets",
            "snapshot",
            "timestamp"
          ],
          "properties": {
            "root": {
              "type": "object",
              "required": [
                "keyids",
                "threshold"
              ],
              "properties": {
                "keyids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/keyId"
                  },
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "targets": {
              "type": "object",
              "required": [
                "keyids",
                "threshold"
              ],
              "properties": {
                "keyids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/keyId"
                  },
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "snapshot": {
              "type": "object",
              "required": [
                "keyids",
                "threshold"
              ],
              "properties": {
                "keyids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/keyId"
                  },
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            "timestamp": {
              "type": "object",
              "required": [
                "keyids",
                "threshold"
              ],
              "properties": {
                "keyids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/keyId"
                  },
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "pins": {
          "type": "object",
          "description": "Certificate pins of the servers an app talks to (SEC-041): per host name, at least two distinct SPKI pins, the key in use and a backup. Signed offline with the root, so an online key cannot change them.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$",
            "maxLength": 253
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/spkiPin"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "signatures": {
      "$ref": "common.schema.json#/$defs/signatures"
    }
  },
  "additionalProperties": false
}
