{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/pxl/currencies.schema.json",
  "title": "ISO 4217 currencies",
  "description": "Currency codes and minor units for money values (PXL-005).",
  "type": "object",
  "required": [
    "description",
    "currencies"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "currencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "minorUnits"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "minorUnits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
