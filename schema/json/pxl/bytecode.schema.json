{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/pxl/bytecode.schema.json",
  "title": "PXL bytecode",
  "description": "Opcodes, comparison kinds, constant tags and error kinds of the PXL bytecode (ADR-0009). Codes are permanent.",
  "type": "object",
  "required": [
    "version",
    "description",
    "opcodes",
    "comparisons",
    "constants",
    "errors"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "opcodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "code",
          "operands",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "code": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "operands": {
            "type": "array",
            "items": {
              "enum": [
                "u8",
                "u16",
                "u32"
              ]
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "tag",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "tag": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "code",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "code": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
