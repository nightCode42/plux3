{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/pxl/stdlib.schema.json",
  "title": "PXL standard library",
  "description": "The PXL standard library (spec Appendix E.3, ADR-0009). Every overload has a permanent ID.",
  "type": "object",
  "required": [
    "description",
    "groups",
    "enums",
    "macros",
    "functions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "feature",
          "phase",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "feature": {
            "type": "string",
            "pattern": "^pxl(\\.[a-z0-9]+)?\\.v[0-9]+$"
          },
          "phase": {
            "type": "string",
            "pattern": "^P([0-9]|1[0-5])$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "values",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "macros": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "id",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "group",
          "description",
          "overloads"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^([a-z][a-zA-Z0-9]*\\.)?[a-z][a-zA-Z0-9]*$"
          },
          "category": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "overloads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "params",
                "result"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "params": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "type"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-zA-Z0-9]*$"
                      },
                      "type": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9<>,?]*$"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "result": {
                  "type": "string"
                },
                "variadic": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
