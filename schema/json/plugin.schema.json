{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/plugin.schema.json",
  "title": "Plux plugin document",
  "description": "A plugin: its pages, state, collections and requested capabilities (SCH-021). File: `plugins/<key>/plugin.json`.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "key",
    "name",
    "icon",
    "team",
    "entryPage",
    "pages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "plugin"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "key": {
      "$ref": "common.schema.json#/$defs/key"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "icon": {
      "$ref": "common.schema.json#/$defs/icon"
    },
    "team": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Owning team."
    },
    "entryPage": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Identifiers of the plugin's pages; each has a file under `pages/`."
    },
    "fallbackPage": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "capabilities": {
      "type": "object",
      "x-plux-type": "Capabilities",
      "description": "Capabilities the plugin requests; everything else is denied (SEC-080).",
      "properties": {
        "networkDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
            "maxLength": 253
          },
          "uniqueItems": true
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "x-plux-type": "FunctionGrant",
            "description": "A function the plugin may call, with an optional alias (FN-006).",
            "required": [
              "id",
              "function"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "function": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$",
                "maxLength": 128
              },
              "alias": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "maxLength": 32
              },
              "requiresAssurance": {
                "$ref": "common.schema.json#/$defs/assuranceLevel"
              }
            },
            "patternProperties": {
              "^x-": true
            },
            "additionalProperties": false
          }
        },
        "deviceApis": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/deviceApi"
          },
          "uniqueItems": true
        },
        "nativeRoutes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/routeName"
          },
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "maxLength": 32
      },
      "uniqueItems": true
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/typeDecl"
      }
    },
    "state": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stateEntry"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/collection"
      }
    },
    "droppedCollections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "description": "IDs of collections this document no longer declares. Their data is deleted from devices that still hold it; the publisher acknowledges the warning this raises (DB-005)."
    },
    "dataSources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/dataSource"
      }
    },
    "triggers": {
      "$ref": "common.schema.json#/$defs/triggers"
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false
}
