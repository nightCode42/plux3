{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/app.schema.json",
  "title": "Plux app document",
  "description": "An app: its plugins, theme, locales, environments, shared data and policies (SCH-020). File: `app.json`.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "key",
    "name",
    "icon",
    "defaultLocale",
    "supportedLocales",
    "theme",
    "entryRoute",
    "plugins",
    "environments",
    "securityProfile",
    "sync",
    "minRuntimeVersion"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "app"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "key": {
      "$ref": "common.schema.json#/$defs/key"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "icon": {
      "$ref": "common.schema.json#/$defs/icon"
    },
    "defaultLocale": {
      "$ref": "common.schema.json#/$defs/locale"
    },
    "supportedLocales": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/locale"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "theme": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "entryRoute": {
      "$ref": "common.schema.json#/$defs/routeName"
    },
    "navigation": {
      "type": "object",
      "x-plux-type": "NavigationPolicy",
      "description": "App-wide navigation: the page for unknown routes, deep links and tabbed shells (NAV-005, NAV-006, NAV-008, NAV-011, ADR-0040).",
      "properties": {
        "notFound": {
          "$ref": "common.schema.json#/$defs/routeName"
        },
        "deepLinks": {
          "type": "object",
          "x-plux-type": "DeepLinkPolicy",
          "description": "The links the app answers (NAV-008): its hosts for `https` links and its custom schemes, and path patterns mapped to routes. `https://<host>/p/<route-name>?…` always resolves, so no pattern may start with `/p/`.",
          "properties": {
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$",
                "maxLength": 253
              },
              "uniqueItems": true
            },
            "schemes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+.-]*$",
                "maxLength": 64,
                "not": {
                  "enum": [
                    "http",
                    "https"
                  ]
                }
              },
              "uniqueItems": true
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "x-plux-type": "DeepLinkRoute",
                "description": "A path pattern mapped to a route: literal segments and `{name}` segments, each naming a parameter of the route; query parameters fill the route's other parameters by name, converted to their declared types.",
                "required": [
                  "path",
                  "route"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(/([A-Za-z0-9._~-]+|\\{[a-z][a-zA-Z0-9]*\\}))+$",
                    "maxLength": 512
                  },
                  "route": {
                    "$ref": "common.schema.json#/$defs/routeName"
                  }
                },
                "patternProperties": {
                  "^x-": true
                },
                "additionalProperties": false
              }
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        },
        "shells": {
          "type": "array",
          "items": {
            "type": "object",
            "x-plux-type": "Shell",
            "description": "A tabbed shell; each tab keeps its own navigation stack, and `switchTab` selects a tab by key (NAV-005, NAV-006).",
            "required": [
              "key",
              "tabs"
            ],
            "properties": {
              "key": {
                "$ref": "common.schema.json#/$defs/key"
              },
              "tabs": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "x-plux-type": "ShellTab",
                  "description": "A tab of a shell: its label, icon and the route it opens with.",
                  "required": [
                    "key",
                    "label",
                    "icon",
                    "initialRoute"
                  ],
                  "properties": {
                    "key": {
                      "$ref": "common.schema.json#/$defs/key"
                    },
                    "label": {
                      "$ref": "common.schema.json#/$defs/propValue"
                    },
                    "icon": {
                      "$ref": "common.schema.json#/$defs/propValue"
                    },
                    "initialRoute": {
                      "$ref": "common.schema.json#/$defs/routeName"
                    }
                  },
                  "patternProperties": {
                    "^x-": true
                  },
                  "additionalProperties": false
                }
              }
            },
            "patternProperties": {
              "^x-": true
            },
            "additionalProperties": false
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/key"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Keys of the app's plugins, in display order; each has a directory `plugins/<key>/`."
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "x-plux-type": "Environment",
        "description": "An environment with values for the declared variables (DAT-003).",
        "required": [
          "key",
          "name"
        ],
        "properties": {
          "key": {
            "$ref": "common.schema.json#/$defs/key"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "$ref": "common.schema.json#/$defs/name"
            },
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/value"
            }
          }
        },
        "patternProperties": {
          "^x-": true
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/field"
      },
      "description": "Non-secret environment variables available in PXL as `env.<name>` (DAT-003)."
    },
    "dataSources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/dataSource"
      }
    },
    "nativeCatalogue": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "securityProfile": {
      "$ref": "common.schema.json#/$defs/securityProfile"
    },
    "sync": {
      "type": "object",
      "x-plux-type": "SyncPolicy",
      "description": "Sync policy (§10.4).",
      "required": [
        "startup",
        "activation"
      ],
      "properties": {
        "startup": {
          "type": "object",
          "x-plux-type": "StartupPolicy",
          "description": "Start-up behaviour (SYN-003).",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "$ref": "common.schema.json#/$defs/startupMode"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          },
          "patternProperties": {
            "^x-": true
          },
          "additionalProperties": false
        },
        "activation": {
          "$ref": "common.schema.json#/$defs/activationPolicy"
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "minRuntimeVersion": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "requiredFeatures": {
      "$ref": "common.schema.json#/$defs/requiredFeaturesPolicy"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "x-plux-type": "FlagDecl",
        "description": "A typed feature flag, available in PXL as `flags.<name>` (ABT-006).",
        "required": [
          "name",
          "type",
          "default"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "type": {
            "$ref": "common.schema.json#/$defs/flagType"
          },
          "default": {
            "$ref": "common.schema.json#/$defs/value"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/description"
          }
        },
        "patternProperties": {
          "^x-": true
        },
        "additionalProperties": false
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/typeDecl"
      }
    },
    "state": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stateEntry"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/collection"
      }
    },
    "userContext": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/field"
      },
      "description": "Attributes the host provides about the signed-in user, available in PXL as `user.<name>`."
    },
    "hostEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "x-plux-type": "HostEventDecl",
        "description": "A typed event plugins send to the host app with `emitHostEvent`; `plux codegen` generates a Dart class for it (HST-013, HST-030, ADR-0039).",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/field"
            }
          },
          "direction": {
            "$ref": "common.schema.json#/$defs/hostEventDirection"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/description"
          }
        },
        "patternProperties": {
          "^x-": true
        },
        "additionalProperties": false
      }
    },
    "telemetry": {
      "type": "object",
      "x-plux-type": "TelemetryPolicy",
      "description": "What the runtime reports (ANL-003, ADR-0034).",
      "properties": {
        "sampling": {
          "type": "object",
          "description": "The share of each consent-gated event type the runtime keeps, from 0 to 1 in steps of 0.001; 1 when absent. The host app can only lower a rate; operational events (`session_start`, `sync_result`, `error`, `rasp_detection`) are never sampled.",
          "propertyNames": {
            "enum": [
              "session_end",
              "screen_view",
              "render_perf",
              "action_run",
              "api_call",
              "function_call",
              "custom",
              "experiment_exposure"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "push": {
      "type": "object",
      "x-plux-type": "PushPolicy",
      "description": "Push notifications (NAV-008, ADR-0040): whether the app uses them, so a generated project carries the platform configuration, and the payload key under which a notification names `{route, params}` for `Plux.handlePushPayload`.",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "payloadKey": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$",
          "maxLength": 64,
          "description": "The payload key holding `{route, params}`; `plux` when absent."
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false
}
