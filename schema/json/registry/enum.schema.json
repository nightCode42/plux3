{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/registry/enum.schema.json",
  "title": "Plux enum",
  "description": "An enumeration used by props (ADR-0010). Files: schema/widgets/enums/<Name>.json.",
  "type": "object",
  "required": [
    "name",
    "id",
    "revision",
    "revisions",
    "description",
    "values"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/typeName"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "revisions": {
      "$ref": "common.schema.json#/$defs/revisions"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "flutter": {
      "type": "object",
      "description": "The Flutter enum mirrored; every value is covered or excluded.",
      "required": [
        "library",
        "enum"
      ],
      "properties": {
        "library": {
          "$ref": "common.schema.json#/$defs/flutterLibrary"
        },
        "enum": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        }
      },
      "additionalProperties": false
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "A value.",
        "required": [
          "name",
          "id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "revision": {
            "$ref": "common.schema.json#/$defs/revision"
          },
          "deprecated": {
            "$ref": "common.schema.json#/$defs/deprecation"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/description"
          }
        },
        "additionalProperties": false
      }
    },
    "excluded": {
      "$ref": "common.schema.json#/$defs/excluded"
    }
  },
  "additionalProperties": false
}
