{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/limits.schema.json",
  "title": "Plux limits registry",
  "description": "The single registry of limits (LIM-001, spec \u00a730.4).",
  "type": "object",
  "required": [
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/limit"
      }
    }
  },
  "$defs": {
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "unit",
        "default",
        "max",
        "scopes",
        "enforcedBy",
        "phase",
        "requirements",
        "description"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z]*\\.[a-z][a-zA-Z]*$",
          "description": "Stable key: area, dot, name in lowerCamelCase."
        },
        "unit": {
          "enum": [
            "bytes",
            "count",
            "microseconds",
            "milliseconds",
            "operations",
            "codepoints"
          ]
        },
        "default": {
          "type": "integer",
          "minimum": 1,
          "description": "Installation default."
        },
        "warning": {
          "type": "integer",
          "minimum": 1,
          "description": "Explicit warning threshold; when absent, warnings start at 80% of the limit (LIM-003)."
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "description": "Hard maximum; no scope can set a larger value."
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "installation",
              "organization",
              "app",
              "plugin"
            ]
          },
          "description": "Levels at which the limit can be set; lower levels can only tighten (LIM-002)."
        },
        "enforcedBy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "compiler",
              "server",
              "runtime",
              "studio"
            ]
          }
        },
        "phase": {
          "type": "string",
          "pattern": "^P([0-9]|1[0-5])$"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]{3}$"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
