# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The baseline `make dev` pulls (assets/plux/README.md); the directories
# the pubspec lists stay, with a placeholder each.
/assets/plux/*
!/assets/plux/README.md
!/assets/plux/bundles/
!/assets/plux/assets/
/assets/plux/bundles/*
/assets/plux/assets/*
!/assets/plux/bundles/.gitkeep
!/assets/plux/assets/.gitkeep
# The defines `make dev-starter` writes for the seeded stack.
/.dart_defines.json
