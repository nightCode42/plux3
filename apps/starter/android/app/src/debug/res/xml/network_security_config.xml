<!-- Debug builds only: besides the system's, trust certificate authorities
     installed on the device, such as the development CA of `make dev`
     (deploy/compose/README.md). HTTPS only; release builds have no such
     configuration. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
