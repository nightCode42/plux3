<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: `make dev` serves Plux over HTTPS with a
         development CA (https://localhost:8080, or 10.0.2.2 from the
         emulator). The network security config also trusts CAs installed
         on the device. Profile and release builds keep Android's default. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
