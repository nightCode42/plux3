# The Plux module's pods (Flutter, the module, its plugins), as the
# Flutter add-to-app guide describes; `flutter pub get` in ../plux_module
# writes the podhelper first.

platform :ios, '15.0'

flutter_application_path = '../plux_module'
load File.join(flutter_application_path, '.ios', 'Flutter', 'podhelper.rb')

target 'HostApp' do
  # Dynamic frameworks: Xcode 26 has no Swift compatibility libraries for
  # static ones that target iOS before 15 (flutter/flutter#175905).
  use_frameworks!
  install_all_flutter_pods flutter_application_path
end

post_install do |installer|
  flutter_post_install(installer)
end
