// Written by plux test; do not edit.
// ignore_for_file: implementation_imports

import 'dart:typed_data';

import 'package:flutter/material.dart';
import 'package:plux_flutter/plux_flutter.dart';

/// The ID of the app under test.
const pluxTestAppId = '01e0c450-6c00-7000-8000-000000000001';

/// The public key of this run, the only root key the runtime trusts.
final pluxTestRootKeys = <PluxPublicKey>[
  PluxPublicKey(
    keyId: '6f2f732c84351d4da8d053c8f7e4e1de',
    algorithm: 'ed25519',
    role: 'targets',
    publicKey: Uint8List.fromList([12, 6, 229, 212, 153, 153, 62, 127, 1, 199, 125, 120, 67, 141, 165, 140, 239, 77, 59, 191, 16, 176, 220, 3, 157, 143, 5, 186, 222, 110, 99, 71]),
  ),
];

/// Native routes show their name.
final pluxTestNativeRoutes = <String, PluxNativeRoute<Object?, Object?>>{
  'profile': PluxNativeRoute<Object?, Object?>(
    params: (json) => json,
    builder: (context, params) => Scaffold(
      body: Center(child: Text('native route profile')),
    ),
  ),
};

/// Native slots are empty.
final pluxTestNativeSlots = <String, PluxNativeSlot>{
  'MapCard': PluxNativeSlot((context, slot) => const SizedBox.shrink()),
};

/// Native actions return nothing.
final pluxTestNativeActions = <String, PluxNativeAction<Object?, Object?>>{
  'sharePlace': PluxNativeAction<Object?, Object?>(
    input: (json) => json,
    handler: (input) => null,
  ),
};
