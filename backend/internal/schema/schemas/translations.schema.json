{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/translations.schema.json",
  "title": "Plux translations document",
  "description": "The messages of one locale, by translation-key identifier, in ICU MessageFormat (I18N-001). File: `translations/<locale>.json`.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "locale",
    "messages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "translations"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "locale": {
      "$ref": "common.schema.json#/$defs/locale"
    },
    "messages": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 65536
      }
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false
}
